{
  "name": "modern-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:production": "set NODE_ENV=production && npm run build",
    "export": "next build && next export",
    "start": "next start",
    "postbuild": "next-sitemap",
    "lint": "eslint",
    "analyze": "set ANALYZE=true && npm run build",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "BUNDLE_ANALYZE=browser npm run build",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "analyze:budget": "node scripts/analyze-bundle.js && node scripts/performance-monitor.js",
    "monitor:performance": "node scripts/performance-monitor.js",
    "monitor:watch": "node scripts/performance-monitor.js watch",
    "deploy:check": "node scripts/deploy-check.js",
    "deploy:check:pre": "node scripts/deploy-check.js pre",
    "deploy:check:post": "node scripts/deploy-check.js post",
    "deploy:health": "curl -f https://thedatawithjose.github.io/health",
    "deploy:validate": "npm run deploy:check:pre && npm run build:production && npm run deploy:check:post",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:performance": "playwright test e2e/performance-audit.spec.ts",
    "test:performance:headed": "playwright test e2e/performance-audit.spec.ts --headed",
    "test:performance:report": "playwright test e2e/performance-audit.spec.ts --reporter=html",
    "test:performance:quick": "playwright test e2e/performance-quick.spec.ts",
    "test:performance:quick:headed": "playwright test e2e/performance-quick.spec.ts --headed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.22.0",
    "@sentry/tracing": "^7.120.4",
    "@types/dompurify": "^3.0.5",
    "@vercel/analytics": "^1.5.0",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^2.30.1",
    "next": "16.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "web-vitals": "^5.1.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "jsdom": "^27.0.1",
    "next-sitemap": "^4.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.3"
  }
}
